{
  "manifestVersion": 1,
  "id": "azdo-intelligence-hub",
  "publisher": "YOUR-PUBLISHER-ID",
  "version": "1.0.0",
  "name": "Azure DevOps Intelligence Hub",
  "description": "Repositories, Pipelines, Work Items, Security & User Activity dashboard for Azure DevOps.",
  "public": false,
  "categories": ["Azure Repos", "Azure Boards", "Azure Pipelines"],
  "targets": [
    { "id": "Microsoft.VisualStudio.Services" }
  ],
  "icons": {
    "default": "img/logo.png"
  },
  "scopes": [
    "vso.code",
    "vso.build",
    "vso.work",
    "vso.project",
    "vso.identity",
    "vso.graph"
  ],
  "contributions": [
    {
      "id": "azdo-intelligence-hub-hub",
      "type": "ms.vss-web.hub",
      "targets": [
        "ms.vss-web.project-hub-groups-collection"
      ],
      "properties": {
        "name": "Intelligence Hub",
        "order": 99,
        "uri": "dist/index.html"
      }
    }
  ],
  "files": [
    {
      "path": "dist",
      "addressable": true
    },
    {
      "path": "img",
      "addressable": true
    }
  ]
}
